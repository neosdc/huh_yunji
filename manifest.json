  },
  "nyang/ok_12": {
    "path": "voice/v1/nyang/ok_12.mp3",
    "text": "최고냥, 계속 가 보냥!"
  },
  "nyang/ok_13": {
    "path": "voice/v1/nyang/ok_13.mp3",
    "text": "빙고냥!"
  },
  "nyang/ok_14": {
    "path": "voice/v1/nyang/ok_14.mp3",
    "text": "똑똑하냥!"
  },
  "nyang/ok_15": {
    "path": "voice/v1/nyang/ok_15.mp3",
    "text": "그거냥! 맞았냥!"
  },
  "nyang/ok_16": {
    "path": "voice/v1/nyang/ok_16.mp3",
    "text": "천만냥짜리 실력이냥!"
  },
  "nyang/ok_17": {
    "path": "voice/v1/nyang/ok_17.mp3",
    "text": "이대로만 하면 된다냥!"
  },
  "nyang/ok_18": {
    "path": "voice/v1/nyang/ok_18.mp3",
    "text": "와, 쉽게 풀었냥!"
  },
  "nyang/ok_19": {
    "path": "voice/v1/nyang/ok_19.mp3",
    "text": "완벽하냥!"
  },
  "nyang/ok_20": {
    "path": "voice/v1/nyang/ok_20.mp3",
    "text": "눈이 반짝이냥!"
  },
  "nyang/ok_21": {
    "path": "voice/v1/nyang/ok_21.mp3",
    "text": "꽤 하는구냥!"
  },
  "nyang/ok_22": {
    "path": "voice/v1/nyang/ok_22.mp3",
    "text": "박수를 보내냥!"
  },
  "nyang/ok_23": {
    "path": "voice/v1/nyang/ok_23.mp3",
    "text": "정확하냥!"
  },
  "nyang/ok_24": {
    "path": "voice/v1/nyang/ok_24.mp3",
    "text": "이야, 멋진 솜씨냥!"
  },
  "nyang/bad_01": {
    "path": "voice/v1/nyang/bad_01.mp3",
    "text": "아쉽냥"
  },
  "nyang/bad_02": {
    "path": "voice/v1/nyang/bad_02.mp3",
    "text": "아니냥"
  },
  "nyang/bad_03": {
    "path": "voice/v1/nyang/bad_03.mp3",
    "text": "틀렸냥"
  },
  "nyang/bad_04": {
    "path": "voice/v1/nyang/bad_04.mp3",
    "text": "노력해냥"
  },
  "nyang/bad_05": {
    "path": "voice/v1/nyang/bad_05.mp3",
    "text": "분발해냥"
  },
  "nyang/bad_06": {
    "path": "voice/v1/nyang/bad_06.mp3",
    "text": "아깝냥, 다시 해 보냥!"
  },
  "nyang/bad_07": {
    "path": "voice/v1/nyang/bad_07.mp3",
    "text": "괜찮냥, 누구나 틀리냥!"
  },
  "nyang/bad_08": {
    "path": "voice/v1/nyang/bad_08.mp3",
    "text": "조금만 더 생각해 보냥!"
  },
  "nyang/bad_09": {
    "path": "voice/v1/nyang/bad_09.mp3",
    "text": "다음엔 맞힐 수 있냥!"
  },
  "nyang/bad_10": {
    "path": "voice/v1/nyang/bad_10.mp3",
    "text": "틀려도 배우면 된다냥!"
  },
  "nyang/bad_11": {
    "path": "voice/v1/nyang/bad_11.mp3",
    "text": "천천히 다시 보냥!"
  },
  "nyang/bad_12": {
    "path": "voice/v1/nyang/bad_12.mp3",
    "text": "한 번 더 도전해 보냥!"
  },
  "nyang/bad_13": {
    "path": "voice/v1/nyang/bad_13.mp3",
    "text": "실수는 괜찮냥!"
  },
  "nyang/bad_14": {
    "path": "voice/v1/nyang/bad_14.mp3",
    "text": "아쉽지만 힘내냥!"
  },
  "nyang/bad_15": {
    "path": "voice/v1/nyang/bad_15.mp3",
    "text": "다음 문제는 잘할 수 있냥!"
  },
  "nyang/bad_16": {
    "path": "voice/v1/nyang/bad_16.mp3",
    "text": "포기하지 말고 가 보냥!"
  },
  "nyang/bad_17": {
    "path": "voice/v1/nyang/bad_17.mp3",
    "text": "살짝 헷갈렸냥!"
  },
  "nyang/bad_18": {
    "path": "voice/v1/nyang/bad_18.mp3",
    "text": "정답을 눈여겨봐 두냥!"
  },
  "nyang/slow_01": {
    "path": "voice/v1/nyang/slow_01.mp3",
    "text": "시간이 없냥"
  },
  "nyang/slow_02": {
    "path": "voice/v1/nyang/slow_02.mp3",
    "text": "자냥"
  },
  "nyang/slow_03": {
    "path": "voice/v1/nyang/slow_03.mp3",
    "text": "졸고있냥"
  },
  "nyang/slow_04": {
    "path": "voice/v1/nyang/slow_04.mp3",
    "text": "모르냥"
  },
  "nyang/slow_05": {
    "path": "voice/v1/nyang/slow_05.mp3",
    "text": "느긋하냥"
  },
  "nyang/slow_06": {
    "path": "voice/v1/nyang/slow_06.mp3",
    "text": "뭐하냥"
  },
  "nyang/slow_07": {
    "path": "voice/v1/nyang/slow_07.mp3",
    "text": "시간이 간다냥, 서둘러 보냥!"
  },
  "nyang/slow_08": {
    "path": "voice/v1/nyang/slow_08.mp3",
    "text": "째깍째깍 시간이 줄어든다냥!"
  },
  "nyang/slow_09": {
    "path": "voice/v1/nyang/slow_09.mp3",
    "text": "조금만 서두르냥!"
  },
  "nyang/slow_10": {
    "path": "voice/v1/nyang/slow_10.mp3",
    "text": "생각이 너무 깊냥?"
  },
  "nyang/slow_11": {
    "path": "voice/v1/nyang/slow_11.mp3",
    "text": "시계를 한번 보냥!"
  },
  "nyang/slow_12": {
    "path": "voice/v1/nyang/slow_12.mp3",
    "text": "아직 할 수 있냥, 힘내냥!"
  },
  "nyang/slow_13": {
    "path": "voice/v1/nyang/slow_13.mp3",
    "text": "앗, 시간이 반이나 갔냥!"
  },
  "nyang/slow_14": {
    "path": "voice/v1/nyang/slow_14.mp3",
    "text": "빨리빨리 풀어 보냥!"
  },
  "nyang/hiAS_01": {
    "path": "voice/v1/nyang/hiAS_01.mp3",
    "text": "덧셈 뺄셈도 같이 해 보냥!"
  },
  "nyang/hiAS_02": {
    "path": "voice/v1/nyang/hiAS_02.mp3",
    "text": "숫자를 모으고 덜어 보냥?"
  },
  "nyang/hiAS_04": {
    "path": "voice/v1/nyang/hiAS_04.mp3",
    "text": "더하고 빼면서 놀아 보냥!"
  },
  "nyang/hiAS_05": {
    "path": "voice/v1/nyang/hiAS_05.mp3",
    "text": "숫자 놀이를 시작해 보냥!"
  },
  "nyang/hiAS_06": {
    "path": "voice/v1/nyang/hiAS_06.mp3",
    "text": "덧셈 뺄셈은 어렵지 않다냥!"
  },
  "nyang/hiAS_07": {
    "path": "voice/v1/nyang/hiAS_07.mp3",
    "text": "하나씩 세어 보면 쉽다냥!"
  },
  "nyang/hiAS_08": {
    "path": "voice/v1/nyang/hiAS_08.mp3",
    "text": "오늘도 계산 실력을 키워 보냥!"
  },
  "nyang/result_01": {
    "path": "voice/v1/nyang/result_01.mp3",
    "text": "훌륭하냥!"
  },
  "nyang/result_02": {
    "path": "voice/v1/nyang/result_02.mp3",
    "text": "조금만 더 노력하냥"
  },
  "nyang/result_03": {
    "path": "voice/v1/nyang/result_03.mp3",
    "text": "노력하냥"
  },
  "nyang/result_04": {
    "path": "voice/v1/nyang/result_04.mp3",
    "text": "더 많은 노력이 필요하냥"
  },
  "nyang/result_05": {
    "path": "voice/v1/nyang/result_05.mp3",
    "text": "와, 전부 맞혔냥! 최고냥!"
  },
  "nyang/result_06": {
    "path": "voice/v1/nyang/result_06.mp3",
    "text": "완벽한 한 판이었냥!"
  },
  "nyang/result_07": {
    "path": "voice/v1/nyang/result_07.mp3",
    "text": "천만냥을 줘도 아깝지 않냥!"
  },
  "nyang/result_08": {
    "path": "voice/v1/nyang/result_08.mp3",
    "text": "박수 짝짝짝! 대단하냥!"
  },
  "nyang/result_09": {
    "path": "voice/v1/nyang/result_09.mp3",
    "text": "거의 다 왔냥! 한 번만 더 하냥!"
  },
  "nyang/result_10": {
    "path": "voice/v1/nyang/result_10.mp3",
    "text": "아깝냥, 조금만 더 하면 완벽하냥!"
  },
  "nyang/result_11": {
    "path": "voice/v1/nyang/result_11.mp3",
    "text": "잘했냥! 틀린 것만 다시 보냥!"
  },
  "nyang/result_12": {
    "path": "voice/v1/nyang/result_12.mp3",
    "text": "절반은 넘었냥, 계속 해 보냥!"
  },
  "nyang/result_13": {
    "path": "voice/v1/nyang/result_13.mp3",
    "text": "연습하면 더 잘할 수 있냥!"
  },
  "nyang/result_14": {
    "path": "voice/v1/nyang/result_14.mp3",
    "text": "틀린 문제를 다시 풀어 보냥!"
  },
  "nyang/result_15": {
    "path": "voice/v1/nyang/result_15.mp3",
    "text": "괜찮냥, 천천히 다시 해 보냥!"
  },
  "nyang/result_16": {
    "path": "voice/v1/nyang/result_16.mp3",
    "text": "처음엔 누구나 어렵냥, 힘내냥!"
  },
  "nyang/result_17": {
    "path": "voice/v1/nyang/result_17.mp3",
    "text": "배우는 중이냥, 한 번 더 해 보냥!"
  },
  "nyang/hiML_01": {
    "path": "voice/v1/nyang/hiML_01.mp3",
    "text": "곱셈도 천천히 해 보냥!"
  },
  "nyang/hiML_02": {
    "path": "voice/v1/nyang/hiML_02.mp3",
    "text": "큰 숫자도 한 칸씩 풀면 된다냥!"
  },
  "nyang/hiML_04": {
    "path": "voice/v1/nyang/hiML_04.mp3",
    "text": "곱셈 놀이터에 어서 와냥!"
  },
  "nyang/hiML_05": {
    "path": "voice/v1/nyang/hiML_05.mp3",
    "text": "큰 수도 겁낼 것 없다냥!"
  },
  "nyang/hiML_06": {
    "path": "voice/v1/nyang/hiML_06.mp3",
    "text": "자리를 맞춰서 차근차근 풀어 보냥!"
  },
  "nyang/hiML_07": {
    "path": "voice/v1/nyang/hiML_07.mp3",
    "text": "곱셈 실력을 쑥쑥 키워 보냥!"
  },
  "nyang/hiML_08": {
    "path": "voice/v1/nyang/hiML_08.mp3",
    "text": "곱하고 더하면 답이 나온다냥!"
  },
  "nyang/ph_hi_01": {
    "path": "voice/v1/nyang/ph_hi_01.mp3",
    "text": "오늘은 글자가 내는 소리를 찾아보냥!"
  },
  "nyang/ph_hi_02": {
    "path": "voice/v1/nyang/ph_hi_02.mp3",
    "text": "귀를 쫑긋 세우고 소리를 들어 보냥?"
  },
  "nyang/ph_hi_03": {
    "path": "voice/v1/nyang/ph_hi_03.mp3",
    "text": "같이 파닉스로 놀아 보냥!"
  },
  "nyang/ph_hi_05": {
    "path": "voice/v1/nyang/ph_hi_05.mp3",
    "text": "소리를 잘 들으면 영어가 읽힌다냥!"
  },
  "nyang/ph_hi_06": {
    "path": "voice/v1/nyang/ph_hi_06.mp3",
    "text": "영어 소리를 하나씩 모아 보냥!"
  },
  "nyang/ph_hi_07": {
    "path": "voice/v1/nyang/ph_hi_07.mp3",
    "text": "글자 이름 말고 소리를 들어 보냥!"
  },
  "nyang/ph_hi_08": {
    "path": "voice/v1/nyang/ph_hi_08.mp3",
    "text": "오늘은 어떤 소리를 만날까냥?"
  },
  "nyang/ph_hi_09": {
    "path": "voice/v1/nyang/ph_hi_09.mp3",
    "text": "소리를 이어 붙이면 단어가 된다냥!"
  },
  "nyang/ph_hi_10": {
    "path": "voice/v1/nyang/ph_hi_10.mp3",
    "text": "귀 기울이면 영어가 들린다냥!"
  },
  "nyang/ph_hi_11": {
    "path": "voice/v1/nyang/ph_hi_11.mp3",
    "text": "파닉스 놀이터에 어서 와냥!"
  },
  "nyang/ph_hi_12": {
    "path": "voice/v1/nyang/ph_hi_12.mp3",
    "text": "한 소리씩 천천히 익혀 보냥!"
  },
  "nyang/ph_s3_01": {
    "path": "voice/v1/nyang/ph_s3_01.mp3",
    "text": "훌륭하냥! 소리를 다 알아챘냥!"
  },
  "nyang/ph_s3_02": {
    "path": "voice/v1/nyang/ph_s3_02.mp3",
    "text": "대단하냥! 별 세 개냥!"
  },
  "nyang/ph_s3_03": {
    "path": "voice/v1/nyang/ph_s3_03.mp3",
    "text": "소리를 정말 잘 알아챘냥!"
  },
  "nyang/ph_s3_04": {
    "path": "voice/v1/nyang/ph_s3_04.mp3",
    "text": "귀가 아주 밝구냥!"
  },
  "nyang/ph_s3_05": {
    "path": "voice/v1/nyang/ph_s3_05.mp3",
    "text": "파닉스 박사가 따로 없냥!"
  },
  "nyang/ph_s3_06": {
    "path": "voice/v1/nyang/ph_s3_06.mp3",
    "text": "와, 전부 맞혔냥! 멋지냥!"
  },
  "nyang/ph_s2_01": {
    "path": "voice/v1/nyang/ph_s2_01.mp3",
    "text": "잘했냥! 한 판 더 해 보냥?"
  },
  "nyang/ph_s2_02": {
    "path": "voice/v1/nyang/ph_s2_02.mp3",
    "text": "좋냥! 조금만 더 하면 별 세 개냥!"
  },
  "nyang/ph_s2_03": {
    "path": "voice/v1/nyang/ph_s2_03.mp3",
    "text": "잘하고 있냥! 조금만 더 하냥!"
  },
  "nyang/ph_s2_04": {
    "path": "voice/v1/nyang/ph_s2_04.mp3",
    "text": "소리가 점점 들린다냥!"
  },
  "nyang/ph_s2_05": {
    "path": "voice/v1/nyang/ph_s2_05.mp3",
    "text": "좋아졌냥! 한 번 더 도전해 보냥?"
  },
  "nyang/ph_s2_06": {
    "path": "voice/v1/nyang/ph_s2_06.mp3",
    "text": "별 두 개냥! 다음엔 세 개냥!"
  },
  "nyang/ph_s1_01": {
    "path": "voice/v1/nyang/ph_s1_01.mp3",
    "text": "괜찮냥, 다시 들으면 더 잘할 수 있냥!"
  },
  "nyang/ph_s1_02": {
    "path": "voice/v1/nyang/ph_s1_02.mp3",
    "text": "노력했냥! 한 판 더 해 보냥?"
  },
  "nyang/ph_s1_03": {
    "path": "voice/v1/nyang/ph_s1_03.mp3",
    "text": "시작이 반이냥! 또 해 보냥!"
  },
  "nyang/ph_s1_04": {
    "path": "voice/v1/nyang/ph_s1_04.mp3",
    "text": "들을수록 점점 쉬워진다냥!"
  },
  "nyang/ph_s1_05": {
    "path": "voice/v1/nyang/ph_s1_05.mp3",
    "text": "천천히 하면 잘할 수 있냥!"
  },
  "nyang/ph_s1_06": {
    "path": "voice/v1/nyang/ph_s1_06.mp3",
    "text": "별 하나도 소중하냥, 힘내냥!"
  }
}