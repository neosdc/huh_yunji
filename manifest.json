{
  "nyang/hi_01": {
    "path": "voice/v1/nyang/hi_01.mp3",
    "text": "{call}! 어서 와냥! 나는 천만냥냥이냥."
  },
  "nyang/hi_02": {
    "path": "voice/v1/nyang/hi_02.mp3",
    "text": "오늘도 구구단으로 놀아 보냥?"
  },
  "nyang/hi_03": {
    "path": "voice/v1/nyang/hi_03.mp3",
    "text": "같이 구구단을 익혀 보냥!"
  },
  "nyang/hi_04": {
    "path": "voice/v1/nyang/hi_04.mp3",
    "text": "천만냥을 들고 응원하러 왔냥!"
  },
  "nyang/hi_05": {
    "path": "voice/v1/nyang/hi_05.mp3",
    "text": "{name}! 구구단 자신있냥?"
  },
  "nyang/hi_06": {
    "path": "voice/v1/nyang/hi_06.mp3",
    "text": "구구단은 다외우고 노냥?!"
  },
  "nyang/hi_07": {
    "path": "voice/v1/nyang/hi_07.mp3",
    "text": "오늘은 어떤 단을 정복해 보냥?"
  },
  "nyang/hi_08": {
    "path": "voice/v1/nyang/hi_08.mp3",
    "text": "구구단 놀이터에 온 걸 환영한다냥!"
  },
  "nyang/hi_09": {
    "path": "voice/v1/nyang/hi_09.mp3",
    "text": "천천히 하나씩 외워 보냥!"
  },
  "nyang/hi_10": {
    "path": "voice/v1/nyang/hi_10.mp3",
    "text": "{call}! 오늘도 반갑다냥!"
  },
  "nyang/hi_11": {
    "path": "voice/v1/nyang/hi_11.mp3",
    "text": "구구단 박사가 되어 보냥!"
  },
  "nyang/hi_12": {
    "path": "voice/v1/nyang/hi_12.mp3",
    "text": "{name}! 같이 놀자냥!"
  },
  "nyang/hi_13": {
    "path": "voice/v1/nyang/hi_13.mp3",
    "text": "곱하기가 점점 쉬워질 거냥!"
  },
  "nyang/hi_14": {
    "path": "voice/v1/nyang/hi_14.mp3",
    "text": "준비됐으면 시작해 보냥!"
  },
  "nyang/ok_01": {
    "path": "voice/v1/nyang/ok_01.mp3",
    "text": "잘했냥"
  },
  "nyang/ok_02": {
