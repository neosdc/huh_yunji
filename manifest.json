    "text": "멋지냥"
  },
  "nyang/ok_04": {
    "path": "voice/v1/nyang/ok_04.mp3",
    "text": "훌륭하냥"
  },
  "nyang/ok_05": {
    "path": "voice/v1/nyang/ok_05.mp3",
    "text": "대단하냥"
  },
  "nyang/ok_06": {
    "path": "voice/v1/nyang/ok_06.mp3",
    "text": "맞냥"
  },
  "nyang/ok_07": {
    "path": "voice/v1/nyang/ok_07.mp3",
    "text": "정답이냥!"
  },
  "nyang/ok_08": {
    "path": "voice/v1/nyang/ok_08.mp3",
    "text": "딱 맞았냥!"
  },
  "nyang/ok_09": {
    "path": "voice/v1/nyang/ok_09.mp3",
