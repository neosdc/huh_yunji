{
  "nyang/hi_01": {
    "path": "voice/v1/nyang/hi_01.mp3",
    "text": "{call}! 어서 와냥! 나는 천만냥냥이냥."
  },
  "nyang/hi_02": {
    "path": "voice/v1/nyang/hi_02.mp3",
